{
  "name": "fakebits",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "A fake Twitch bits wallet to kill the urge to donate. Simulation only, not affiliated with Twitch, no real money.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @fakebits/extension dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @fakebits/extension e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juandaghost/fakebits.git"
  },
  "homepage": "https://github.com/juandaghost/fakebits",
  "bugs": "https://github.com/juandaghost/fakebits/issues"
}
